# ==============================================================================
# مؤسسة إيجاز للنقليات · EJAZ Transport — Environment Variables Template
# ==============================================================================
# Set your deployment variables below. For development, safe sandbox values or
# mock adapters are automatically utilized if external services are unconfigured.

# Application Server Port & Host
# In production, specify your target port (default: 8080 or 3000)
APP_PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Session Security (JWT)
# In production, replace with a high-entropy cryptographically secure random secret
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRES_IN=7d

# Relational Database (PostgreSQL)
# When PostgreSQL is not connected, the system automatically runs the ACID-compliant
# In-Memory Development Database Adapter matching this exact schema.
DATABASE_URL=postgresql://user:password@localhost:5432/ejaz_transport

# Enterprise GPS AVL Telemetry Integration
# Point to your enterprise GPS hardware provider API (e.g. Wialon, TrackSolid, or Ejaz Gateway).
# Use http://localhost:8080/api/dev/gps for local development telemetry testing.
GPS_PROVIDER_API_KEY=
GPS_PROVIDER_ENDPOINT=

# Google Maps Platform Key
# Replace with your restricted Google Maps API key in production.
# In development, leave blank or use a dev placeholder to run the Maps Development Adapter.
GOOGLE_MAPS_API_KEY=

# Demo Accounts Feature Flag
# Set to true in development/staging to enable the quick demo accounts selector.
# Set to false in production to disable and hide all demo accounts.
ENABLE_DEMO_ACCOUNTS=true
VITE_ENABLE_DEMO_ACCOUNTS=true
