rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 64));
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll(['userId']) &&
        data.keys().hasOnly(['userId', 'theme', 'language', 'updatedAt']) &&
        data.userId is string && data.userId == userId &&
        (!('theme' in data) || (data.theme is string && data.theme.size() <= 16)) &&
        (!('language' in data) || (data.language is string && data.language.size() <= 8));
    }

    function isValidChatMessage(data, userId) {
      return data.keys().hasAll(['conversationId', 'userId', 'role', 'text']) &&
        data.keys().hasOnly(['conversationId', 'userId', 'role', 'text', 'modelUsed', 'agentRole', 'createdAt']) &&
        data.conversationId is string && data.conversationId.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.role is string && (data.role == 'user' || data.role == 'model' || data.role == 'system') &&
        data.text is string && data.text.size() <= 20000 &&
        (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 64)) &&
        (!('agentRole' in data) || (data.agentRole is string && data.agentRole.size() <= 64));
    }

    // User document and private sub-collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Strict PII protection
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      match /preferences/{prefId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserPreferences(incoming(), userId);
        allow update: if isOwner(userId) && isValidUserPreferences(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      match /conversations/{conversationId}/messages/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChatMessage(incoming(), userId);
        allow update: if isOwner(userId) && isValidChatMessage(incoming(), userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
