++
++export interface VehicleModelAsset {
++  url: string | null;
++  format: "glb" | "gltf" | null;
++  source: "NONE" | "OFFICIAL_UPLOAD";
++  fileName?: string;
++  sizeBytes?: number;
++  sha256?: string;
++  scale: number;
++  rotationY: number;
++  yOffset: number;
++  cameraRadius?: number;
++  updatedAt?: string;
