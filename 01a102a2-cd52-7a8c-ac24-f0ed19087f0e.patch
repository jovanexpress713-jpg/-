++  /* 2. The legacy brand-based resolver no longer returns stock renders. */
++  for (const vehicle of FLEET) {
++    const resolved = imageFor(vehicle.brand, vehicle.body);
++    assert.strictEqual(
++      resolved,
++      expected[vehicle.body as string] ?? expected.curtain,
