++function persistDocument(
++  requestId: string,
++  kind: string,
++  fileName: string,
++  dataUrl: string
++): { url: string; sizeBytes: number } {
++  const match = /^data:([^;]+);base64,(.*)$/s.exec(String(dataUrl || ""));
++  const payload = match ? match[2] : String(dataUrl || "");
++  const buffer = Buffer.from(payload, "base64");
