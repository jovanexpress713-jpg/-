++/* ------------------------------------------------------------------ */
++/* Persistence                                                         */
++/* ------------------------------------------------------------------ */
++
++const PUBLIC_PREFIX = "/uploads/registrations";
++
++function storePath(): string {
++  if (process.env.REGISTRATION_STORE_PATH) return path.resolve(process.env.REGISTRATION_STORE_PATH);
++  return path.resolve(process.cwd(), "data", "registration-requests.json");
